# Copy this file to .env in the project directory and fill in your values.

# WebUI administrator password (required; startup fails if left empty).
GW_ADMIN_PASSWORD=

# Host address of the Compose port mapping: loopback by default; use a LAN interface IP
# for LAN access. Only Docker Compose reads GW_BIND (compose.yml "ports"); it has no effect
# with `docker run` (use the -p/--publish address) or with `network_mode: host`.
GW_BIND=127.0.0.1

# WebUI port inside the container; mapped to 127.0.0.1:8080 by default.
GW_PORT=8080

# GW_HOST (application listen address) is intentionally not set here.
# - Default bridge network (the shipped compose.yml): the image listens on 0.0.0.0 inside
#   the container and GW_BIND above chooses host exposure. Do not set GW_HOST=127.0.0.1:
#   the published port would become unreachable.
# - network_mode: host: there is no port mapping, GW_BIND has no effect, and the image
#   listens on every host interface. Set GW_HOST=127.0.0.1 here to keep it local
#   (honored starting with image 20261019.2; earlier images ignore it).

# Scheduler: 1-4 workers; minimum sync/discovery intervals must be at least 1 minute.
GW_TICK_SECONDS=30
GW_WORKERS=2
GW_MIN_SYNC_MINUTES=5
GW_MIN_DISCOVERY_MINUTES=15
# Git output inactivity timeout; runs that keep making progress have no total time limit.
GW_STALL_MINUTES=10
# Retention applies only to run and activity logs, not preservation events or Git archives.
GW_LOG_RETENTION_DAYS=90
